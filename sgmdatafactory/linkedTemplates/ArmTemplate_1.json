							"linkedService": {
								"referenceName": "ls_datalake",
								"type": "LinkedServiceReference"
							},
							"name": "sink5"
						}
					],
					"transformations": [
						{
							"name": "derivedColumnCountry"
						},
						{
							"name": "SelectCols"
						},
						{
							"name": "renamecolumn"
						},
						{
							"name": "derivedgenderflag"
						},
						{
							"name": "derivedgengerfemaleflag"
						},
						{
							"name": "filterabove25exclmexico"
						},
						{
							"name": "derivedname"
						},
						{
							"name": "castticketcost"
						},
						{
							"name": "AirportsName"
						},
						{
							"name": "alterRow1"
